#!/usr/bin/env bash
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found, skipping format check" >&2
  exit 0
fi

mapfile -t STAGED_RS < <(
  git diff --cached --name-only --diff-filter=ACM -- '*.rs'
)

if [ ${#STAGED_RS[@]} -eq 0 ]; then
  exit 0
fi

echo "pre-commit: running cargo fmt on ${#STAGED_RS[@]} staged file(s)"

cargo fmt --all

RE_STAGED=0
for f in "${STAGED_RS[@]}"; do
  if ! git diff --quiet -- "$f" 2>/dev/null; then
    git add -- "$f"
    RE_STAGED=$((RE_STAGED + 1))
  fi
done

if [ $RE_STAGED -gt 0 ]; then
  echo "pre-commit: reformatted $RE_STAGED file(s) and re-staged them"
fi

exit 0
