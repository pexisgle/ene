#!/usr/bin/env bash
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found, skipping format check" >&2
  exit 0
fi

mapfile -t STAGED_RS < <(
  git diff --cached --name-only --diff-filter=ACM -- '*.rs'
)

if [ ${#STAGED_RS[@]} -eq 0 ]; then
  exit 0
fi

echo "pre-commit: checking cargo fmt for ${#STAGED_RS[@]} staged Rust file(s)"

if ! cargo fmt --all -- --check; then
  echo "pre-commit: formatting check failed; run 'cargo fmt --all' and stage the intended changes" >&2
  exit 1
fi

exit 0
