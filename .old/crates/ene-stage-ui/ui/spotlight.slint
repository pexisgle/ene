import { EneTheme, EneField } from "theme.slint";

export struct SpotlightEntry {
    id: string,
    label: string,
}

export component SpotlightSurface inherits Window {
    background: #101218ee;
    default-font-family: "Noto Sans CJK JP";
    title: title-text;

    in-out property <string> query;
    in-out property <[SpotlightEntry]> entries: [];
    in-out property <int> selected: 0;
    in-out property <string> title-text: "Spotlight";
    in-out property <string> placeholder: "Type a command…";
    in-out property <string> empty-text: "";
    in-out property <bool> input-focused: TextInputInterface.text-input-focused;

    callback run(string);
    callback dismissed();

    VerticalLayout {
        padding: EneTheme.space-4;
        spacing: EneTheme.space-3;
        EneField {
            text <=> query;
            placeholder: placeholder;
            field-height: 40px;
            accepted => {
                if entries.length > 0 {
                    run(entries[max(0, min(selected, entries.length - 1))].id);
                }
            }
        }
        if entries.length == 0: Text {
            text: empty-text;
            color: EneTheme.fg-muted;
        }
        Flickable {
            viewport-height: list.preferred-height;
            viewport-y: max(0px, min(selected * 36px, max(0px, list.preferred-height - self.height)));
            list := VerticalLayout {
                spacing: EneTheme.space-1;
                for entry[index] in entries: Rectangle {
                    background: index == selected ? EneTheme.accent : (row-touch.has-hover ? EneTheme.bg-elevated : transparent);
                    border-radius: EneTheme.radius;
                    height: 32px;
                    HorizontalLayout {
                        padding: EneTheme.space-2;
                        Text {
                            text: entry.label;
                            color: index == selected ? #101218 : EneTheme.fg;
                            vertical-alignment: center;
                        }
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.run(entry.id);
                        }
                    }
                }
            }
        }
    }
}
