{
  "version": 2,
  "character": "Alicia",
  "user_name": "User",
  "$schema": "./schema/settings.schema.json",
  "ai": {
    "providers": {
      "openrouter": {
        "kind": "openai_compatible",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key": {
          "source": "inline",
          "env": "OPENAI_API_KEY",
          "inline": ""
        }
      },
      "local_embed": {
        "kind": "local_gguf",
        "model": "jina-embeddings-v5-text-small",
        "quantization": "F16",
        "model_path": "",
        "acceleration": "auto",
        "gpu_layers": "auto",
        "context_size": 2048
      }
    },
    "tasks": {
      "chat": {
        "provider": "openrouter",
        "model": "xiaomi/mimo-v2.5",
        "max_tokens": 8192
      },
      "embedding": {
        "provider": "local_embed"
      },
      "classifier": {
        "provider": "openrouter",
        "model": "google/gemini-2.5-flash-lite"
      },
      "proactive": null
    }
  },
  "store": {
    "enabled": true
  },
  "tools": {
    "enabled": true,
    "list": {
      "app": { "enable": true },
      "browser": { "enable": true },
      "fs": { "enable": true },
      "utility": { "enable": true },
      "web": {
        "enable": true,
        "brave_api_key": "",
        "exa_api_key": "",
        "tavily_api_key": ""
      }
    },
    "mcp_servers": []
  },
  "mind": {
    "emotion": {
      "enabled": true,
      "classifier_language": "ja"
    },
    "proactive": {
      "enabled": false,
      "interval_seconds": 60,
      "min_idle_seconds": 120,
      "cooldown_seconds": 300
    }
  },
  "desktop": {
    "language": "ja",
    "graphics": {
      "quality": "medium"
    }
  }
}
