{
  "version": 1,
  "character": "Alicia",
  "user_name": "pexisgle",
  "runtime_rules": "Keep responses relatively short and sweet, suitable for displaying on a screen overlay.",
  "$schema": "./schema/settings.schema.json",
  "cognition": {
    "enabled": true,
    "context": {
      "max_prompt_tokens": 12000,
      "recent_turns": 8,
      "scene_summary_tokens": 800,
      "memory_budget_tokens": 1800,
      "semantic_budget_tokens": 1200,
      "style_example_budget_tokens": 600,
      "compression_enabled": true,
      "scene_turn_threshold": 12,
      "chapter_span_threshold": 5,
      "arc_span_threshold": 3,
      "compression_timeout_secs": 60
    },
    "memory": {
      "write_every_turn": true,
      "hybrid_search": true,
      "decay_enabled": true,
      "default_forgetting_half_life_days": 30.0,
      "min_confidence_to_persist": 0.65,
      "extraction_timeout_secs": 30,
      "tool_grounding": {
        "enabled": true,
        "max_summary_chars": 500,
        "persist_success_procedure": true,
        "persist_failure_reflection": true,
        "persist_user_visible_episodic": true,
        "min_confidence": 0.6000000238418579
      },
      "use_hyde": false,
      "recall_result_limit": 8,
      "recall_similarity_threshold": 0.3499999940395355,
      "recall_min_score": 0.20000000298023224,
      "rerank_enabled": false,
      "rerank_candidate_limit": 16,
      "rerank_timeout_secs": 10,
      "mmr_enabled": true,
      "mmr_lambda": 0.699999988079071,
      "mmr_duplicate_cluster_threshold": 0.75,
      "mmr_min_slots_semantic": 1,
      "mmr_min_slots_episodic": 1,
      "mmr_min_slots_user_profile": 1,
      "mmr_min_slots_commitment": 1,
      "mmr_source_diversity_bonus": 0.05000000074505806,
      "require_migration": false
    },
    "emotion": {
      "enabled": true,
      "engine": "hybrid",
      "decay_half_life_minutes": 30.0,
      "expression_hysteresis_seconds": 4.0,
      "llm_can_propose_expression": true,
      "llm_expression_is_advisory": true,
      "classifier_timeout_secs": 30,
      "classifier_min_confidence": 0.5,
      "classifier_language": "ja",
      "classifier_model": "google/gemini-2.5-flash-lite",
      "classifier_max_tokens": 0
    },
    "character": {
      "compile_ccv3_to_semantic_memory": true,
      "always_include_identity_kernel": true,
      "style_retrieval": true,
      "identity_kernel_max_tokens": 400
    }
  },
  "desktop": {
    "graphics": {
      "mask_render_downsample": 8,
      "target_fps": 60,
      "shadow_quality": "medium",
      "antialiasing_mode": "fxaa",
      "debug_fps": 30
    },
    "language": "ja"
  },
  "memory": {
    "db_path": "",
    "enabled": true,
    "recall_limit": 5,
    "recency_weight": 0.3,
    "similarity_threshold": 0.5,
    "similarity_weight": 0.7,
    "time_decay_hours": 24.0
  },
  "provider": {
    "api_key": {
      "env": "OPENAI_API_KEY",
      "inline": "",
      "source": "inline"
    },
    "base_url": "https://openrouter.ai/api/v1",
    "embedding": {
      "backend": "local",
      "cloud": {
        "dimensions": 1536,
        "model": "text-embedding-3-small"
      },
      "local": {
        "model": "jina-embeddings-v5-text-small",
        "quantization": "F16"
      },
      "query_prefix": null
    },
    "model": "xiaomi/mimo-v2.5",
    "name": "openai-compatible"
  },
  "session": {
    "auto_split": true,
    "min_turns_before_split": 3,
    "recall_limit": 3,
    "summarization": {
      "base_url": "",
      "model": ""
    },
    "timeout_minutes": 30,
    "topic_similarity_threshold": 0.5
  },
  "tools": {
    "enabled": true,
    "list": {
      "app": {
        "enable": true
      },
      "browser": {
        "enable": true
      },
      "fs": {
        "enable": true
      },
      "utility": {
        "enable": true
      },
      "web": {
        "brave_api_key": "",
        "enable": true,
        "exa_api_key": "",
        "tavily_api_key": ""
      }
    },
    "max_rounds": 10,
    "mcp_servers": [],
    "rag": {
      "background_index_on_startup": false,
      "enabled": true,
      "final_n": 6,
      "forced": [
        "utility.question",
        "utility.todo_add",
        "utility.get_current_time"
      ],
      "min_similarity": 0.25,
      "rerank_candidates": 24,
      "top_k": 12,
      "use_hyde": true,
      "use_rerank": true
    },
    "timeout_ms": 60000
  }
}