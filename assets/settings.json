{
  "version": 1,
  "character": "Alicia",
  "user_name": "pexisgle",
  "runtime_rules": "Keep responses relatively short and sweet, suitable for displaying on a screen overlay.",
  "$schema": "./schema/settings.schema.json",
  "desktop": {
    "graphics": {
      "mask_render_downsample": 8,
      "target_fps": 60,
      "shadow_quality": "medium",
      "antialiasing_mode": "fxaa"
    }
  },
  "memory": {
    "enabled": true,
    "db_path": "",
    "recall_limit": 5,
    "similarity_threshold": 0.5,
    "time_decay_hours": 24.0,
    "similarity_weight": 0.7,
    "recency_weight": 0.3
  },
  "provider": {
    "api_key": {
      "env": "OPENAI_API_KEY",
      "inline": "",
      "source": "inline"
    },
    "base_url": "https://openrouter.ai/api/v1",
    "embedding": {
      "backend": "local",
      "cloud": {
        "dimensions": 1536,
        "model": "text-embedding-3-small"
      },
      "local": {
        "model": "jina-embeddings-v5-text-small",
        "quantization": "F16"
      },
      "query_prefix": null
    },
    "model": "xiaomi/mimo-v2.5",
    "name": "openai-compatible"
  },
  "session": {
    "auto_split": true,
    "min_turns_before_split": 3,
    "recall_limit": 3,
    "summarization": {
      "base_url": "",
      "model": ""
    },
    "timeout_minutes": 30,
    "topic_similarity_threshold": 0.5
  },
  "tools": {
    "enabled": true,
    "list": {
      "app": {
        "enable": true
      },
      "browser": {
        "enable": true
      },
      "fs": {
        "enable": true
      },
      "utility": {
        "enable": true
      },
      "web": {
        "brave_api_key": "",
        "enable": true,
        "exa_api_key": "",
        "tavily_api_key": ""
      }
    },
    "max_rounds": 10,
    "mcp_servers": [],
    "rag": {
      "background_index_on_startup": false,
      "enabled": true,
      "final_n": 6,
      "forced": [
        "utility.question",
        "utility.todo_add",
        "utility.get_current_time"
      ],
      "min_similarity": 0.25,
      "rerank_candidates": 24,
      "top_k": 12,
      "use_hyde": true,
      "use_rerank": true
    },
    "timeout_ms": 60000
  }
}