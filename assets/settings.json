{
  "version": 1,
  "character": "Alicia",
  "user_name": "User",
  "$schema": "./schema/settings.schema.json",
  "ai": {
    "local_models": {
      "gemma-4-e2b": {
        "acceleration": "auto",
        "context_size": 2048,
        "gpu_layers": "auto",
        "mmproj_url": "https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/mmproj-F16.gguf",
        "url": "https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/main/gemma-4-E2B-it-Q4_0.gguf"
      },
      "gemma-4-e4b": {
        "acceleration": "auto",
        "context_size": 2048,
        "gpu_layers": "auto",
        "mmproj_url": "https://huggingface.co/unsloth/gemma-4-E4B-it-GGUF/resolve/main/mmproj-F16.gguf",
        "url": "https://huggingface.co/unsloth/gemma-4-E4B-it-GGUF/resolve/main/gemma-4-E4B-it-Q4_0.gguf"
      },
      "jina-v5-small": {
        "acceleration": "auto",
        "context_size": 2048,
        "gpu_layers": "auto",
        "quantization": "F16",
        "url": "https://huggingface.co/jinaai/jina-embeddings-v5-text-small-retrieval/resolve/main/v5-small-retrieval-F16.gguf"
      }
    },
    "providers": {
      "openrouter": {
        "api_key": {
          "env": "OPENROUTER_API_KEY",
          "inline": "",
          "source": "env"
        },
        "base_url": "https://openrouter.ai/api/v1",
        "kind": "openai_compatible"
      }
    },
    "tasks": {
      "chat": {
        "max_tokens": 8192,
        "model": "openai/gpt-4o-mini",
        "provider": "openrouter"
      },
      "classifier": {
        "model": "google/gemini-2.5-flash-lite",
        "provider": "openrouter"
      },
      "embedding": {
        "model": "jina-v5-small",
        "provider": "local"
      },
      "proactive": {
        "model": "gemma-4-e4b",
        "provider": "local"
      }
    }
  },
  "desktop": {
    "graphics": {
      "quality": "medium"
    },
    "language": "ja"
  },
  "mind": {
    "emotion": {
      "enabled": true,
      "classifier_language": "ja"
    },
    "proactive": {
      "enabled": false,
      "interval_seconds": 10,
      "min_idle_seconds": 20,
      "cooldown_seconds": 60,
      "sources": {
        "conversation": true,
        "activity": true,
        "screen_summary": false
      }
    }
  },
  "store": {
    "enabled": true
  },
  "tools": {
    "enabled": true,
    "list": {
      "app": {
        "enable": true
      },
      "browser": {
        "enable": true
      },
      "fs": {
        "enable": true
      },
      "utility": {
        "enable": true
      },
      "web": {
        "brave_api_key": "",
        "enable": true,
        "exa_api_key": "",
        "tavily_api_key": ""
      }
    },
    "mcp_servers": []
  }
}