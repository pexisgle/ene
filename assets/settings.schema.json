{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ene Settings",
  "description": "Configuration schema for Ene application settings.json",
  "type": "object",
  "required": ["version", "character"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Configuration file format version",
      "minimum": 1,
      "default": 1
    },
    "character": {
      "type": "string",
      "description": "Name of the selected character",
      "default": "Alicia"
    },
    "app": {
      "type": "object",
      "description": "Application-specific settings (graphics)",
      "properties": {
        "graphics": {
          "type": "object",
          "description": "Graphics and rendering quality settings. All fields have defaults.",
          "properties": {
            "mask_render_downsample": {
              "type": "integer",
              "description": "Downsample factor for mask rendering. Lower values increase quality but reduce performance.",
              "enum": [4, 6, 8],
              "default": 8
            },
            "target_fps": {
              "type": "integer",
              "description": "Target frames per second. 0 means unlimited.",
              "enum": [0, 15, 30, 60, 120],
              "default": 60
            },
            "shadow_quality": {
              "type": "string",
              "description": "Shadow map resolution quality",
              "enum": ["Low", "Medium", "High"],
              "default": "Medium"
            },
            "antialiasing_mode": {
              "type": "string",
              "description": "Anti-aliasing technique used for rendering",
              "enum": ["Off", "Fxaa", "Smaa", "Taa"],
              "default": "Fxaa"
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "description": "AI provider configuration",
      "properties": {
        "provider_name": {
          "type": "string",
          "description": "Name of the AI provider",
          "default": "openai-compatible"
        },
        "model": {
          "type": "string",
          "description": "Model identifier to use for chat completions",
          "default": "gpt-4o-mini"
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for the AI provider API",
          "default": ""
        },
        "api_key": {
          "type": "string",
          "description": "API key for the AI provider",
          "default": ""
        }
      }
    },
    "user_name": {
      "type": "string",
      "description": "Display name for the user in chat context",
      "default": "User"
    },
    "runtime_rules": {
      "type": "string",
      "description": "System-level runtime behavior rules/prompting for the AI",
      "default": "Keep responses relatively short and sweet, suitable for displaying on a screen overlay."
    },
    "tool_calling_enabled": {
      "type": "boolean",
      "description": "Whether AI tool calling is enabled",
      "default": true
    },
    "max_tool_call_rounds": {
      "type": "integer",
      "description": "Maximum number of consecutive tool call rounds allowed",
      "minimum": 0,
      "default": 10
    },
    "mcp_servers": {
      "type": "array",
      "description": "List of MCP server configurations",
      "default": [],
      "items": {
        "$ref": "#/definitions/McpServerConfig"
      }
    },
    "embedding": {
      "type": "object",
      "description": "Embedding provider configuration (always enabled)",
      "properties": {
        "provider_type": {
          "type": "string",
          "description": "Type of embedding provider",
          "enum": ["api", "local"],
          "default": "local"
        },
        "model": {
          "type": "string",
          "description": "Model identifier for text embeddings",
          "default": "jina-embeddings-v5-text-small"
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for the embedding provider",
          "default": ""
        },
        "dimensions": {
          "type": ["integer", "null"],
          "description": "Dimensionality of embedding vectors",
          "minimum": 1,
          "default": null
        },
        "gguf_quantization": {
          "type": "string",
          "description": "GGUF quantization level for the local embedding model",
          "default": "F16",
          "examples": ["F16", "Q8_0", "Q4_K_M", "Q4_K_S", "Q5_K_M", "Q2_K", "IQ4_XS"]
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Long-term memory settings",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether long-term memory is enabled",
          "default": false
        },
        "db_path": {
          "type": "string",
          "description": "Path to the SQLite memory database",
          "default": ""
        },
        "recall_limit": {
          "type": "integer",
          "description": "Maximum number of memory entries to recall per query",
          "minimum": 1,
          "default": 5
        },
        "similarity_threshold": {
          "type": "number",
          "description": "Minimum cosine similarity threshold for recalling memories",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "time_decay_hours": {
          "type": "number",
          "description": "Time decay factor in hours for memory recency scoring",
          "minimum": 0.0,
          "default": 24.0
        },
        "similarity_weight": {
          "type": "number",
          "description": "Weight given to similarity score in memory ranking",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.7
        },
        "recency_weight": {
          "type": "number",
          "description": "Weight given to recency score in memory ranking",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.3
        },
        "auto_session_split": {
          "type": "boolean",
          "description": "Automatically split sessions when topic changes or timeout occurs",
          "default": true
        },
        "session_timeout_minutes": {
          "type": "integer",
          "description": "Minutes of inactivity before automatic session split",
          "minimum": 1,
          "default": 30
        },
        "topic_change_threshold": {
          "type": "number",
          "description": "Embedding similarity threshold for topic change detection",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "min_turns_before_split": {
          "type": "integer",
          "description": "Minimum conversation turns before a session can be split",
          "minimum": 1,
          "default": 3
        },
        "summary_recall_limit": {
          "type": "integer",
          "description": "Maximum number of past conversation summaries injected",
          "minimum": 0,
          "default": 3
        },
        "summarization_model": {
          "type": "string",
          "description": "Model for conversation summarization",
          "default": ""
        },
        "summarization_base_url": {
          "type": "string",
          "description": "Base URL for summarization API",
          "default": ""
        }
      }
    },
    "sandbox": {
      "type": "object",
      "description": "Sandbox permission and resource limit settings",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the sandbox permission system is enabled",
          "default": true
        },
        "allowed_directories": {
          "type": "array",
          "description": "List of directories the AI is allowed to read from",
          "default": ["."],
          "items": { "type": "string" }
        },
        "writable_directories": {
          "type": "array",
          "description": "List of directories the AI is allowed to write to",
          "default": ["."],
          "items": { "type": "string" }
        },
        "blocked_commands": {
          "type": "array",
          "description": "List of regex patterns for shell commands that are blocked",
          "default": ["rm\\s+-rf\\s+/", "dd\\s+if=", "mkfs", ":\\s*\\{\\s*\\|\\s*&\\s*;\\s*\\}"],
          "items": { "type": "string" }
        },
        "max_read_bytes": {
          "type": "integer",
          "description": "Maximum bytes allowed for a single read operation",
          "minimum": 0,
          "default": 51200
        },
        "max_write_bytes": {
          "type": "integer",
          "description": "Maximum bytes allowed for a single write operation",
          "minimum": 0,
          "default": 1048576
        },
        "shell_timeout_ms": {
          "type": "integer",
          "description": "Maximum duration in milliseconds for a shell command execution",
          "minimum": 0,
          "default": 120000
        },
        "max_shell_output_bytes": {
          "type": "integer",
          "description": "Maximum bytes of shell command output to retain",
          "minimum": 0,
          "default": 51200
        },
        "max_shell_output_lines": {
          "type": "integer",
          "description": "Maximum lines of shell command output to retain",
          "minimum": 0,
          "default": 2000
        }
      }
    },
    "tools": {
      "type": "object",
      "description": "Per-tool enable/disable and configuration",
      "default": {},
      "additionalProperties": {
        "$ref": "#/definitions/ToolEntry"
      }
    }
  },
  "definitions": {
    "McpServerConfig": {
      "type": "object",
      "description": "Configuration for a single MCP server",
      "required": ["name", "enabled", "transport"],
      "properties": {
        "name": { "type": "string", "description": "Display name of the MCP server" },
        "enabled": { "type": "boolean", "description": "Whether this MCP server is enabled" },
        "transport": { "$ref": "#/definitions/McpTransport" }
      }
    },
    "McpTransport": {
      "description": "Transport method for communicating with an MCP server",
      "oneOf": [
        {
          "type": "object",
          "description": "Standard I/O transport",
          "required": ["Stdio"],
          "properties": {
            "Stdio": {
              "type": "object",
              "required": ["command", "args"],
              "properties": {
                "command": { "type": "string", "description": "Executable command to run" },
                "args": { "type": "array", "description": "Arguments passed to the command", "items": { "type": "string" }, "default": [] }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "HTTP/SSE transport",
          "required": ["Http"],
          "properties": {
            "Http": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": { "type": "string", "format": "uri", "description": "HTTP endpoint URL for the MCP server" }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ToolEntry": {
      "type": "object",
      "description": "Enable/disable flag and tool-specific configuration",
      "required": ["enable"],
      "properties": {
        "enable": { "type": "boolean", "description": "Whether this tool is enabled" }
      },
      "additionalProperties": { "description": "Tool-specific configuration passed to set_config()" }
    }
  }
}
