import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Action, NavItem, Heading, Caption, BodyText, Field, Notice, EmptyState, RowCard, Item } from "components.slint";

component SetupPane inherits Rectangle {
    in property <bool> japanese;
    in-out property <int> step;
    in property <bool> busy;
    in property <bool> credential-present;
    in-out property <string> model;
    in-out property <string> secret-draft;
    callback next();
    callback back();
    callback language(bool);
    callback credential(string);
    callback assign(string);
    public function clear-secret() { root.secret-draft = ""; }
    VerticalLayout {
        spacing: 24px; alignment: start;
        Caption { text: root.japanese ? "はじめの設定 · " + (root.step + 1) + " / 5" : "GETTING STARTED · " + (root.step + 1) + " / 5"; }
        HorizontalLayout {
            spacing: 6px; height: 3px;
            for n in 5: Rectangle { height: 3px; border-radius: 2px; background: n <= root.step ? Theme.accent : Theme.border; }
        }
        Heading { text:
            root.step == 0 ? (root.japanese ? "使いやすい言語で。" : "Make yourself at home.") :
            root.step == 1 ? (root.japanese ? "あなたのパートナー、ene。" : "Meet your partner, ene.") :
            root.step == 2 ? (root.japanese ? "送信するデータと費用" : "Your data and costs") :
            root.step == 3 ? (root.japanese ? "AI に接続する準備" : "Connect your AI provider") :
            (root.japanese ? "会話に使うモデル" : "Choose a model for conversation");
        }
        BodyText { text:
            root.step == 0 ? (root.japanese ? "表示言語は、あとから設定で変更できます。" : "You can change the display language in Settings at any time.") :
            root.step == 1 ? (root.japanese ? "ene と会話したり、作業を頼んだりできます。アバターが利用できなくても、会話と設定は使えます。" : "Talk with ene and ask for a hand with your work. Chat and settings work even without an avatar.") :
            root.step == 2 ? (root.japanese ? "会話には OpenAI を使用します。メッセージや必要な会話の文脈がクラウドに送られ、利用に応じた料金が発生します。API キーの登録だけでは送信されません。" : "Conversation uses OpenAI. Your messages and necessary context are sent to the cloud and usage incurs a cost. Registering a key alone does not send a request.") :
            root.step == 3 ? (root.japanese ? "OpenAI API キーを登録します。保存に対応していない環境では、登録できないことをお知らせします。" : "Register your OpenAI API key. If protected storage is unavailable, registration cannot complete.") :
            (root.japanese ? "モデル名を確認してください。割り当てを確定すると、このモデルを会話に利用することに同意します。" : "Check the model name. Assigning it authorizes this model for conversation.");
        }
        if root.step == 0: HorizontalLayout {
            spacing: 12px;
            Action { text: "日本語"; selected: root.japanese; clicked => { root.language(true); } }
            Action { text: "English"; selected: !root.japanese; clicked => { root.language(false); } }
        }
        key-field := Field {
            visible: root.step == 3;
            height: root.step == 3 ? 76px : 0px;
            value <=> root.secret-draft;
            label: "OpenAI API key"; hint: "sk-…"; password: true; enabled: !root.busy;
        }
        if root.step == 4: Field { label: root.japanese ? "モデル名" : "Model name"; hint: "gpt-4.1"; value <=> root.model; enabled: !root.busy; }
        if root.step == 4 && !root.credential-present: Notice { text: root.japanese ? "モデルの割り当てには、API キーの登録が必要です。" : "Register an API key before assigning a model."; }
        HorizontalLayout {
            spacing: 12px;
            Action { text: root.japanese ? "戻る" : "Back"; enabled: root.step > 0 && !root.busy; clicked => { key-field.value = ""; root.back(); } }
            Rectangle { horizontal-stretch: 1; }
            Action {
                text: root.busy ? (root.japanese ? "処理中…" : "Working…") :
                    root.step == 3 ? (root.japanese ? "キーを登録" : "Register key") :
                    root.step == 4 ? (root.japanese ? "同意して割り当て" : "Agree and assign") : (root.japanese ? "次へ" : "Continue");
                primary: true;
                enabled: !root.busy && (root.step != 3 || key-field.value != "") && (root.step != 4 || (root.credential-present && root.model != ""));
                clicked => {
                    if root.step == 3 { root.credential(key-field.value); key-field.value = ""; }
                    else if root.step == 4 { root.assign(root.model); }
                    else { root.next(); }
                }
            }
        }
    }
}

export component ManagementWindow inherits Window {
    title: japanese ? "ene — 設定・管理" : "ene — Settings";
    preferred-width: 1000px; preferred-height: 720px;
    min-width: 720px; min-height: 540px;
    background: Theme.canvas;
    default-font-size: Theme.body-size;
    in-out property <bool> content-live: true;
    in-out property <string> secret-draft;
    in-out property <bool> japanese: true;
    in-out property <int> page: 6;
    in-out property <string> model: "gpt-4.1";
    in-out property <string> cap-amount: "1";
    in-out property <string> deletion-draft;
    in property <int> step;
    in property <bool> busy;
    in property <bool> connected;
    in property <bool> setup-ready;
    in property <bool> credential-present;
    in property <bool> consent-assigned;
    in property <bool> avatar-available;
    in property <bool> avatar-visible;
    in property <bool> memory-more;
    in property <bool> revisions-more;
    in property <bool> usage-more;
    in property <string> status;
    in-out property <string> notice;
    in property <bool> notice-error: true;
    in-out property <string> selected-memory;
    in-out property <string> selected-deletion;
    in-out property <string> confirmation-key;
    in-out property <string> confirmation-title;
    in-out property <string> confirmation-description;
    in-out property <string> confirmation-target;
    in-out property <bool> can-confirm;
    in property <bool> can-resume-deletion;
    in-out property <[Item]> memories;
    in-out property <[Item]> revisions;
    in-out property <[Item]> usage;
    in-out property <[Item]> caps;
    in-out property <[Item]> deletions;
    callback navigate(int);
    callback open-chat();
    callback language(bool);
    callback refresh();
    callback wizard-next();
    callback wizard-back();
    callback register-secret(string);
    callback assign-model(string);
    callback select-memory(string);
    callback next-memory();
    callback next-revisions();
    callback next-usage();
    callback apply-cap(string);
    callback select-deletion(string);
    callback request-deletion(string);
    callback confirm-deletion();
    callback resume-deletion();
    callback confirm-owner();
    callback cancel-owner();
    callback draft-changed();
    callback show-avatar();
    callback hide-avatar();
    public function clear-secret() { root.secret-draft = ""; }
    public function clear-copies() {
        root.secret-draft = ""; root.deletion-draft = ""; root.memories = []; root.revisions = [];
        root.usage = []; root.caps = []; root.deletions = [];
        root.selected-memory = ""; root.selected-deletion = ""; root.notice = "";
        root.confirmation-target = ""; root.confirmation-key = ""; root.confirmation-title = ""; root.confirmation-description = ""; root.can-confirm = false;
    }
    if root.content-live: HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 192px; background: Theme.surface;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                Text { text: "ene"; color: Theme.text; font-size: 24px; font-weight: 600; height: 52px; }
                Caption { text: root.japanese ? "設定" : "PREFERENCES"; }
                NavItem { text: root.japanese ? "一般" : "General"; selected: root.page == 0; clicked => { root.navigate(0); } }
                NavItem { text: root.japanese ? "AI・接続" : "AI & connection"; selected: root.page == 1 || root.page == 6; clicked => { root.navigate(1); } }
                Rectangle { height: 16px; }
                Caption { text: root.japanese ? "データ管理" : "YOUR DATA"; }
                NavItem { text: root.japanese ? "記憶" : "Memory"; selected: root.page == 2; clicked => { root.navigate(2); } }
                NavItem { text: root.japanese ? "利用量・上限" : "Usage & limits"; selected: root.page == 3; clicked => { root.navigate(3); } }
                NavItem { text: root.japanese ? "データ削除" : "Data deletion"; selected: root.page == 4; clicked => { root.navigate(4); } }
                Rectangle { vertical-stretch: 1; }
                Caption { text: root.status; }
                NavItem { text: root.japanese ? "ene について" : "About ene"; selected: root.page == 5; clicked => { root.navigate(5); } }
                Action { text: root.japanese ? "会話を開く" : "Open chat"; clicked => { root.open-chat(); } }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 32px; spacing: 20px;
                if root.page < 6: HorizontalLayout {
                    Heading { text: root.page == 0 ? (root.japanese ? "一般" : "General") :
                        root.page == 1 ? (root.japanese ? "AI・接続" : "AI & connection") :
                        root.page == 2 ? (root.japanese ? "記憶" : "Memory") :
                        root.page == 3 ? (root.japanese ? "利用量・上限" : "Usage & limits") :
                        root.page == 4 ? (root.japanese ? "データ削除" : "Data deletion") :
                        (root.japanese ? "ene について" : "About ene");
                    }
                    if root.page > 0 && root.page < 5: Action { text: root.busy ? (root.japanese ? "取得中…" : "Loading…") : (root.japanese ? "更新" : "Refresh"); enabled: !root.busy && root.connected; clicked => { root.refresh(); } }
                }
                if root.notice != "": Notice { text: root.notice; error: root.notice-error; }
                content := Rectangle {
                    vertical-stretch: 1;
                    if root.page == 6: ScrollView {
                      content-width: self.width;
                      VerticalLayout { alignment: start;
                       setup := SetupPane {
                        secret-draft <=> root.secret-draft;
                        max-width: 560px; horizontal-stretch: 1;
                        japanese: root.japanese; step: root.step; busy: root.busy;
                        credential-present: root.credential-present;
                        model <=> root.model;
                        next => { root.wizard-next(); }
                        back => { root.wizard-back(); }
                        language(ja) => { root.language(ja); }
                        credential(value) => { root.register-secret(value); }
                        assign(value) => { root.assign-model(value); }
                       }
                      }
                    }
                    if root.page != 6: ScrollView {
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 16px; alignment: start; padding-right: 12px;
                            if root.page == 0: VerticalLayout {
                                spacing: 20px;
                                BodyText { text: root.japanese ? "会話に集中できる、あなたのための場所。" : "A quiet place for your conversations."; }
                                Caption { text: root.japanese ? "表示言語" : "Display language"; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Action { text: "日本語"; selected: root.japanese; clicked => { root.language(true); } }
                                    Action { text: "English"; selected: !root.japanese; clicked => { root.language(false); } }
                                }
                                Caption { text: root.japanese ? "表示言語を変えても、会話や記憶の内容は変わりません。" : "Changing the display language leaves your conversations and memories unchanged."; }
                                if !root.setup-ready: Notice { text: root.japanese ? "会話を始めるには、初回セットアップを完了してください。" : "Finish setup to start a conversation."; }
                                if !root.setup-ready: Action { text: root.japanese ? "セットアップを続ける" : "Continue setup"; primary: true; clicked => { root.navigate(6); } }
                                Caption { text: root.japanese ? "デスクトップアバター" : "Desktop avatar"; }
                                if !root.avatar-available: Notice { text: root.japanese ? "アバターは利用できません。会話と設定は引き続き使えます。" : "The avatar is unavailable. Chat and settings remain available."; }
                                if root.avatar-available: HorizontalLayout {
                                    spacing: 12px;
                                    Action { text: root.japanese ? "表示" : "Show"; enabled: !root.avatar-visible && !root.busy; clicked => { root.show-avatar(); } }
                                    Action { text: root.japanese ? "一時的に隠す" : "Hide temporarily"; enabled: root.avatar-visible && !root.busy; clicked => { root.hide-avatar(); } }
                                }
                            }
                            if root.page == 1: VerticalLayout {
                                spacing: 16px;
                                Caption { text: root.japanese ? "接続と登録の状態" : "Connection and registration"; }
                                RowCard { item: { title: "OpenAI", body: root.japanese ? "会話に使う AI プロバイダー" : "AI provider for conversation", state: root.connected ? (root.japanese ? "接続済み" : "Connected") : (root.japanese ? "未接続" : "Disconnected") }; }
                                RowCard { item: { title: root.japanese ? "API キー" : "API key", body: root.japanese ? "キーの値はここには表示されません。" : "Your key is never displayed here.", state: root.credential-present ? (root.japanese ? "登録済み" : "Registered") : (root.japanese ? "未登録" : "Not registered") }; }
                                RowCard { item: { title: root.japanese ? "モデルの割り当て" : "Model assignment", body: root.model, state: root.consent-assigned ? (root.japanese ? "同意済み" : "Authorized") : (root.japanese ? "未設定" : "Not configured") }; }
                                Action { text: root.japanese ? "セットアップを開く" : "Open setup"; primary: true; clicked => { root.navigate(6); } }
                            }
                            if root.page == 2: VerticalLayout {
                                spacing: 12px;
                                Caption { text: root.japanese ? "会話から育った記憶と、その根拠を確認できます。" : "Explore what ene remembers, and where it came from."; }
                                if root.memories.length == 0: EmptyState { title: root.japanese ? "まだ表示する記憶はありません" : "No memories to display"; description: root.japanese ? "記憶が作られると、ここから内容と変更履歴を確認できます。" : "Memories and their revision history will appear here."; }
                                for memory in root.memories: RowCard { item: memory; selected: memory.key == root.selected-memory; clicked(key) => { if !root.busy { root.select-memory(key); } } }
                                if root.memory-more: Action { text: root.japanese ? "さらに読み込む" : "Load more"; enabled: !root.busy; clicked => { root.next-memory(); } }
                                if root.selected-memory != "": Heading { text: root.japanese ? "根拠と変更履歴" : "Sources & revisions"; font-size: 18px; }
                                for revision in root.revisions: RowCard { item: revision; }
                                if root.revisions-more: Action { text: root.japanese ? "履歴をさらに読む" : "More revisions"; enabled: !root.busy; clicked => { root.next-revisions(); } }
                            }
                            if root.page == 3: VerticalLayout {
                                spacing: 12px;
                                Caption { text: root.japanese ? "取得したページの利用明細です。不明な費用は「不明」と表示します。" : "Usage for the retrieved page. Unknown costs are shown as unknown."; }
                                if root.usage.length == 0: EmptyState { title: root.japanese ? "利用明細はまだありません" : "No usage to display"; description: root.japanese ? "AI の利用が記録されると、ここに表示されます。" : "Recorded AI usage will appear here."; }
                                HorizontalLayout {
                                    spacing: 12px; height: 32px;
                                    Caption { text: root.japanese ? "プロバイダ・モデル" : "Provider / model"; horizontal-stretch: 2; }
                                    Caption { text: root.japanese ? "入力 / 出力" : "Input / output"; width: 100px; }
                                    Caption { text: root.japanese ? "料金・状態" : "Cost / status"; width: 150px; }
                                }
                                for row in root.usage: Rectangle {
                                    min-height: 72px; border-radius: 8px; background: Theme.surface;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 12px;
                                        BodyText { text: row.title; horizontal-stretch: 2; }
                                        Caption { text: row.meta; width: 100px; }
                                        VerticalLayout { width: 150px; spacing: 4px; BodyText { text: row.body; } Caption { text: row.state; } }
                                    }
                                }
                                if root.usage-more: Action { text: root.japanese ? "次のページ" : "Next page"; enabled: !root.busy; clicked => { root.next-usage(); } }
                                Heading { text: root.japanese ? "利用上限" : "Spending limits"; font-size: 18px; }
                                for cap in root.caps: RowCard { item: cap; }
                                Field { label: root.japanese ? "全体の日次上限 · USD / UTC 日" : "System daily limit · USD / UTC day"; hint: "1.00"; value <=> root.cap-amount; enabled: !root.busy; }
                                Action { text: root.japanese ? "日次上限を更新" : "Update daily limit"; enabled: !root.busy && root.connected; clicked => { root.apply-cap(root.cap-amount); } }
                            }
                            if root.page == 4: VerticalLayout {
                                spacing: 16px;
                                Notice { text: root.japanese ? "指定した情報を履歴や記憶から完全に削除します。会話で「忘れて」と伝える操作とは異なり、取り消せません。" : "Permanently remove matching information from history and memory. This differs from asking ene to forget and cannot be undone."; }
                                Field { label: root.japanese ? "完全に削除する文字列" : "Exact text to erase"; hint: root.japanese ? "対象の文字列を入力" : "Enter the exact text"; value <=> root.deletion-draft; enabled: !root.busy; edited => { root.draft-changed(); } }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Action { text: root.japanese ? "削除を要求" : "Request deletion"; danger: true; enabled: !root.busy && root.connected && root.deletion-draft != ""; clicked => { root.request-deletion(root.deletion-draft); root.deletion-draft = ""; } }
                                    Action { text: root.japanese ? "確認へ進む" : "Review request"; enabled: !root.busy && root.connected && root.selected-deletion != ""; clicked => { root.confirm-deletion(); } }
                                }
                                Heading { text: root.japanese ? "処理の状況" : "Operation status"; font-size: 18px; }
                                if root.deletions.length == 0: Caption { text: root.japanese ? "取得済みの削除処理はありません。" : "No deletion operations have been retrieved."; }
                                for operation in root.deletions: RowCard { item: operation; selected: operation.key == root.selected-deletion; clicked(key) => { root.select-deletion(key); } }
                                Action { text: root.japanese ? "選択した処理を再開" : "Resume selected operation"; enabled: root.can-resume-deletion && !root.busy; clicked => { root.resume-deletion(); } }
                            }
                            if root.page == 5: VerticalLayout {
                                spacing: 24px;
                                Heading { text: "ene"; font-size: 32px; }
                                BodyText { text: root.japanese ? "あなたと会話し、ともに作業するパートナー。" : "A partner for conversation and work."; }
                                Caption { text: root.japanese ? "インターフェース" : "Interface"; }
                                Rectangle { height: 160px; max-width: 360px; AboutSlint { } }
                            }
                            if root.page == 7: VerticalLayout {
                                spacing: 24px;
                                Caption { text: root.japanese ? "あなたによる確認が必要です" : "YOUR CONFIRMATION IS REQUIRED"; }
                                Heading { text: root.confirmation-title; }
                                BodyText { text: root.confirmation-description; }
                                if root.confirmation-target != "": Caption { text: root.confirmation-target; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Action { text: root.japanese ? "キャンセル" : "Cancel"; enabled: !root.busy; clicked => { root.cancel-owner(); } }
                                    Action { text: root.japanese ? "確認する" : "Confirm"; primary: true; enabled: !root.busy && root.can-confirm; clicked => { root.confirm-owner(); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
