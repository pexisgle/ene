// Semantic tokens: future themes replace this palette, not individual pages.
export global Theme {
    out property <color> canvas: #14171b;
    out property <color> surface: #1c2026;
    out property <color> raised: #252b32;
    out property <color> border: #343d47;
    out property <color> text: #f1f5f7;
    out property <color> muted: #aab5bf;
    out property <color> accent: #84d5c3;
    out property <color> on-accent: #102c25;
    out property <color> danger: #ffa69e;
    out property <length> body-size: 14px;
    out property <length> small-size: 12px;
    out property <length> title-size: 24px;
    out property <length> radius: 8px;
}
