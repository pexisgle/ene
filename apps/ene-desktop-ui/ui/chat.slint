import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Action, Heading, Caption, BodyText, Field, Notice, EmptyState, RowCard, Item, Message } from "components.slint";

export component ChatWindow inherits Window {
    title: "ene";
    preferred-width: 1100px; preferred-height: 760px;
    min-width: 720px; min-height: 540px;
    background: Theme.canvas;
    default-font-size: Theme.body-size;
    in-out property <bool> content-live: true;
    in-out property <bool> japanese: true;
    in-out property <bool> tasks-open: false;
    in-out property <string> draft;
    in-out property <string> workspace-draft;
    in-out property <string> instruction-draft;
    in-out property <[Message]> messages;
    in-out property <[Item]> tasks;
    in-out property <[Item]> details;
    in-out property <string> selected-task;
    in property <string> status;
    in property <string> progress-summary;
    in-out property <string> notice;
    in property <bool> notice-error: true;
    in-out property <string> task-notice;
    in property <bool> busy: false;
    in property <bool> task-busy: false;
    in property <bool> connected: false;
    in property <bool> has-task: false;
    callback open-management();
    callback refresh-history();
    callback refresh-tasks();
    callback select-task(string);
    callback send(string);
    callback workspace(string);
    callback resume(string);
    callback cancel-task();
    public function clear-copies() {
        root.draft = ""; root.workspace-draft = ""; root.instruction-draft = "";
        root.messages = []; root.tasks = []; root.details = []; root.selected-task = "";
        root.notice = ""; root.task-notice = "";
    }
    if root.content-live: VerticalLayout {
        padding: root.width < 1000px ? 16px : 24px; spacing: root.width < 1000px ? 12px : 16px;
        HorizontalLayout {
            spacing: 16px; height: 48px;
            Rectangle {
                width: 40px; height: 40px; border-radius: 12px; background: Theme.raised;
                Text { text: "e"; color: Theme.accent; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1;
                Text { text: "ene"; color: Theme.text; font-size: 20px; font-weight: 600; }
                Caption { text: root.status; }
            }
            Action {
                text: root.japanese ? "作業" : "Tasks"; selected: root.tasks-open;
                clicked => { root.tasks-open = !root.tasks-open; composer.focus(); if root.tasks-open { root.refresh-tasks(); } }
            }
            Action { text: root.japanese ? "設定・管理" : "Settings"; clicked => { root.open-management(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.notice != "": Notice { text: root.notice; error: root.notice-error; }
        if root.progress-summary != "" && !root.tasks-open: HorizontalLayout {
          Action {
            text: root.progress-summary;
            clicked => { root.tasks-open = true; root.refresh-tasks(); }
          }
          Rectangle { horizontal-stretch: 1; }
        }
        workspace := Rectangle {
            vertical-stretch: 1;
            private property <bool> side: root.width >= 1000px;
            conversation := Rectangle {
                x: 0px; y: 0px;
                width: workspace.side && root.tasks-open ? parent.width - 376px : parent.width;
                height: !workspace.side && root.tasks-open ? parent.height - 256px : parent.height;
                VerticalLayout {
                    spacing: 12px;
                    if !root.tasks-open || workspace.side: HorizontalLayout {
                        Caption { text: root.japanese ? "会話" : "CONVERSATION"; horizontal-stretch: 1; }
                        Action { text: root.japanese ? "履歴を更新" : "Refresh history"; enabled: root.connected && !root.busy; clicked => { root.refresh-history(); } }
                    }
                    ScrollView {
                        min-height: 0px;
                        content-width: self.width;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 16px; padding-right: 12px; alignment: start;
                            if root.messages.length == 0: EmptyState {
                                title: root.japanese ? "ここから、会話をはじめよう。" : "A little conversation starts here.";
                                description: root.japanese ? "相談したいことや、手伝ってほしいことを ene に話しかけてください。" : "Tell ene what is on your mind, or what you would like a hand with.";
                            }
                            for message in root.messages: Rectangle {
                                min-height: message-layout.min-height;
                                border-radius: Theme.radius;
                                background: message.owner ? Theme.raised : Theme.surface;
                                message-layout := VerticalLayout {
                                    padding: 16px; spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: message.owner ? (root.japanese ? "あなた" : "You") : "ene"; color: message.owner ? Theme.muted : Theme.accent; font-weight: 600; font-size: 12px; }
                                        Caption { text: message.caption; horizontal-stretch: 0; }
                                    }
                                    BodyText { text: message.text; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: root.tasks-open && !workspace.side ? 64px : 76px; border-radius: 12px; background: Theme.surface;
                        border-width: 1px; border-color: composer.has-focus ? Theme.accent : Theme.border;
                        HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            composer := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.draft;
                                placeholder-text: root.japanese ? "ene にメッセージ…" : "Message ene…";
                                font-size: 14px;
                                enabled: true;
                                accepted => { if !root.busy && root.connected && root.draft != "" { root.send(root.draft); } }
                            }
                            Action {
                                primary: true; text: root.busy ? (root.japanese ? "処理中" : "Working") : (root.japanese ? "送信" : "Send");
                                enabled: !root.busy && root.connected && root.draft != "";
                                clicked => { root.send(root.draft); }
                            }
                        }
                    }
                }
            }
            task-pane := Rectangle {
                visible: root.tasks-open;
                x: workspace.side ? parent.width - 360px : 0px;
                y: workspace.side ? 0px : parent.height - 240px;
                width: workspace.side ? 360px : parent.width;
                height: workspace.side ? parent.height : 240px;
                background: Theme.surface; border-radius: 12px; border-width: 1px; border-color: Theme.border;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        Heading { text: root.japanese ? "作業" : "Tasks"; font-size: 20px; }
                        Action { text: root.japanese ? "更新" : "Refresh"; enabled: !root.task-busy && root.connected; clicked => { root.refresh-tasks(); } }
                        Action { text: root.japanese ? "閉じる" : "Close"; clicked => { root.tasks-open = false; composer.focus(); } }
                    }
                    ScrollView {
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 12px; alignment: start;
                            if root.task-notice != "": Notice { text: root.task-notice; error: true; }
                            if root.tasks.length == 0: EmptyState {
                                title: root.japanese ? "まだ作業はありません" : "No tasks yet";
                                description: root.japanese ? "会話で依頼した作業の進捗や結果を、ここで確認できます。" : "Tasks delegated in conversation will appear here.";
                            }
                            for task in root.tasks: RowCard { item: task; selected: root.selected-task == task.key; clicked(key) => { if !root.task-busy { root.select-task(key); } } }
                            for detail in root.details: RowCard { item: detail; }
                            Field { label: root.japanese ? "作業フォルダ" : "Workspace folder"; hint: root.japanese ? "フォルダのパス" : "Folder path"; value <=> root.workspace-draft; }
                            Action { text: root.japanese ? "フォルダを選択" : "Use folder"; enabled: !root.task-busy && root.connected && root.workspace-draft != ""; clicked => { root.workspace(root.workspace-draft); } }
                            Field { label: root.japanese ? "再開時の指示" : "Instructions for resuming"; hint: root.japanese ? "続きをどう進めるか" : "How should the task continue?"; value <=> root.instruction-draft; }
                            HorizontalLayout {
                                spacing: 8px;
                                Action { text: root.japanese ? "再開" : "Resume"; primary: true; enabled: root.has-task && !root.task-busy && root.instruction-draft != ""; clicked => { root.resume(root.instruction-draft); } }
                                Action { text: root.japanese ? "作業を中止" : "Cancel task"; danger: true; enabled: root.has-task && !root.task-busy; clicked => { root.cancel-task(); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
