{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ene.dev/schemas/diagnostic-event.v1.json",
  "title": "Ene DiagnosticEvent",
  "description": "Opt-in diagnostics channel events for ene-runtime (API v1 / #189).",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "pipeline_phase",
        "pipeline_metrics",
        "actor_panic",
        "tool_health",
        "provider_health",
        "provider_fallback",
        "memory_write",
        "lagged",
        "resync_needed"
      ]
    },
    "turn": { "type": "string" },
    "phase": { "type": "string" },
    "timings": { "type": "object", "additionalProperties": { "type": "integer" } },
    "component": { "type": "string" },
    "message": { "type": "string" },
    "tool": { "type": "string" },
    "status": { "type": "string" },
    "detail": { "type": ["string", "null"] },
    "provider": { "type": "string" },
    "latency_ms": { "type": "integer" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "reason": { "type": "string" },
    "character_id": { "type": "string" },
    "pending_id": { "type": ["integer", "null"] },
    "pending_count": { "type": ["integer", "null"] },
    "permanent_count": { "type": ["integer", "null"] },
    "channel": { "type": "string", "enum": ["events", "diagnostics"] },
    "skipped": { "type": "integer", "minimum": 0 }
  }
}
