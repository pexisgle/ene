{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ene.dev/schemas/public-chat-event.v1.json",
  "title": "Ene PublicChatEvent",
  "description": "Stable JSON mirror of the ene-runtime chat EneEvent bus (API v1 / #189).",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "turn_started",
        "text_delta",
        "performance",
        "tool_call_start",
        "tool_call_result",
        "tool_background_completed",
        "permission_required",
        "user_input_required",
        "context_compressed",
        "terminal",
        "status_changed"
      ]
    },
    "turn": { "type": "string" },
    "origin": { "type": "string", "enum": ["user", "proactive"] },
    "delta": { "type": "string" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "source"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "source": { "type": "string" },
    "name": { "type": "string" },
    "arguments": {},
    "result": { "type": "string" },
    "tool_name": { "type": "string" },
    "task_id": { "type": "string" },
    "status": { "type": "string" },
    "request_id": { "type": "string" },
    "action": { "type": "string" },
    "target": { "type": "string" },
    "description": { "type": "string" },
    "prompt_kind": { "type": "string" },
    "level": { "type": "string" },
    "reason": { "type": "string", "enum": ["done", "failed", "cancelled"] },
    "message": { "type": "string" }
  },
  "oneOf": [
    { "properties": { "type": { "const": "turn_started" } }, "required": ["turn", "origin"] },
    { "properties": { "type": { "const": "text_delta" } }, "required": ["turn", "origin", "delta"] },
    { "properties": { "type": { "const": "performance" } }, "required": ["turn", "origin", "cues", "source"] },
    { "properties": { "type": { "const": "tool_call_start" } }, "required": ["turn", "origin", "name", "arguments"] },
    { "properties": { "type": { "const": "tool_call_result" } }, "required": ["turn", "origin", "name", "result"] },
    { "properties": { "type": { "const": "tool_background_completed" } }, "required": ["tool_name", "task_id", "status"] },
    { "properties": { "type": { "const": "permission_required" } }, "required": ["turn", "origin", "request_id", "action", "target", "description"] },
    { "properties": { "type": { "const": "user_input_required" } }, "required": ["turn", "origin", "request_id", "prompt_kind"] },
    { "properties": { "type": { "const": "context_compressed" } }, "required": ["turn", "origin", "level"] },
    { "properties": { "type": { "const": "terminal" } }, "required": ["turn", "origin", "reason"] },
    { "properties": { "type": { "const": "status_changed" } }, "required": ["status"] }
  ]
}
