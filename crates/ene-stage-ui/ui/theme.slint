// Stage v2 design tokens. User themes overlay these via Rust property sets.

export global EneTheme {
    in-out property <bool> dark: true;
    in-out property <bool> reduced-motion: false;

    in-out property <color> bg: #16181d;
    in-out property <color> bg-elevated: #1e2229;
    in-out property <color> fg: #e8eaed;
    in-out property <color> fg-muted: #9aa0a6;
    in-out property <color> accent: #7eb8ff;
    in-out property <color> danger: #ff8a80;
    in-out property <color> bubble: #262b33;
    in-out property <color> bubble-user: #345a82;
    in-out property <length> space-1: 4px;
    in-out property <length> space-2: 8px;
    in-out property <length> space-3: 12px;
    in-out property <length> space-4: 16px;
    in-out property <length> radius: 10px;
    in-out property <length> type-sm: 12px;
    in-out property <length> type-md: 14px;
    in-out property <length> type-lg: 18px;
    in-out property <duration> motion: 160ms;
}

export component EneButton inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> enabled: true;
    in-out property <bool> primary: true;
    callback clicked();
    border-radius: EneTheme.radius;
    background: !root.enabled ? EneTheme.bg-elevated : (primary ? EneTheme.accent : EneTheme.bg-elevated);
    opacity: enabled ? 1.0 : 0.45;
    height: 32px;
    min-width: 72px;
    horizontal-stretch: 0;
    Text {
        text: root.text;
        color: primary ? #101218 : EneTheme.fg;
        font-size: EneTheme.type-md;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component EneIconButton inherits Rectangle {
    in-out property <string> text;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: EneTheme.radius;
    background: ta.has-hover ? EneTheme.bg : EneTheme.bg-elevated;
    Text {
        text: root.text;
        color: EneTheme.fg;
        font-size: EneTheme.type-md;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component EneCard inherits Rectangle {
    border-radius: EneTheme.radius;
    background: EneTheme.bg-elevated;
    in-out property <string> title;
    in-out property <string> body;
    VerticalLayout {
        padding: EneTheme.space-3;
        spacing: EneTheme.space-1;
        Text {
            text: root.title;
            color: EneTheme.fg;
            font-size: EneTheme.type-md;
        }
        Text {
            text: root.body;
            color: EneTheme.fg-muted;
            font-size: EneTheme.type-sm;
            wrap: word-wrap;
        }
    }
}

export component SpeechBubble inherits Rectangle {
    in-out property <string> text;
    in-out property <string> speaker;
    in property <bool> clickable: false;
    in property <bool> user: false;
    callback clicked();
    border-radius: EneTheme.radius;
    background: user ? EneTheme.bubble-user : EneTheme.bubble;
    VerticalLayout {
        padding: EneTheme.space-3;
        spacing: EneTheme.space-1;
        Text {
            text: root.speaker;
            color: EneTheme.fg-muted;
            font-size: EneTheme.type-sm;
        }
        Text {
            text: root.text;
            color: EneTheme.fg;
            font-size: EneTheme.type-md;
            wrap: word-wrap;
        }
    }
    TouchArea {
        enabled: clickable;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component StatusBubble inherits Rectangle {
    in-out property <string> text;
    border-radius: EneTheme.radius;
    background: #00000099;
    VerticalLayout {
        padding: EneTheme.space-2;
        Text {
            text: root.text;
            color: EneTheme.fg;
            font-size: EneTheme.type-sm;
            wrap: word-wrap;
        }
    }
}

export component Chip inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> selected: false;
    in-out property <bool> enabled: true;
    callback clicked();
    border-radius: 999px;
    background: selected ? EneTheme.accent : (ta.has-hover ? EneTheme.bg : EneTheme.bg-elevated);
    opacity: enabled ? 1.0 : 0.45;
    height: 28px;
    HorizontalLayout {
        padding-left: EneTheme.space-3;
        padding-right: EneTheme.space-3;
        Text {
            text: root.text;
            color: selected ? #101218 : EneTheme.fg;
            font-size: EneTheme.type-sm;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component EneField inherits VerticalLayout {
    in-out property <string> text;
    in-out property <string> placeholder;
    in-out property <string> label;
    in-out property <length> field-height: 36px;
    in-out property <bool> multiline: false;
    callback accepted();
    spacing: 2px;
    if label != "": Text {
        text: label;
        color: EneTheme.fg-muted;
        font-size: EneTheme.type-sm;
    }
    Rectangle {
        height: field-height;
        border-radius: EneTheme.radius;
        background: EneTheme.bg;
        border-width: 1px;
        border-color: EneTheme.fg-muted;
        if input.text == "": Text {
            x: EneTheme.space-2;
            width: parent.width - 16px;
            height: 100%;
            text: placeholder;
            color: EneTheme.fg-muted;
            font-size: EneTheme.type-md;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        input := TextInput {
            x: EneTheme.space-2;
            width: parent.width - 16px;
            height: 100%;
            text <=> root.text;
            color: EneTheme.fg;
            font-size: EneTheme.type-md;
            wrap: multiline ? word-wrap : no-wrap;
            single-line: !multiline;
            accepted => {
                root.accepted();
            }
        }
    }
}
